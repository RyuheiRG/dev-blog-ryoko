---
import "@fontsource-variable/inter/wght.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/global.css";

import BaseHead from "@/components/seo/BaseHead.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import { getSiteSettings } from "@/lib/cms/queries";

interface Props {
  title?: string | null;
  description?: string | null;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>[];
  headerTransparent?: boolean;
  email?: string;
  hideFooterContact?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  noindex,
  type,
  publishedTime,
  modifiedTime,
  tags,
  jsonLd,
  headerTransparent = false,
  email,
  hideFooterContact = false,
} = Astro.props;

const site = await getSiteSettings();
const metricsUrl = import.meta.env.METRICS_API_URL ?? "";
const metricsKey = import.meta.env.METRICS_SITE_KEY ?? "";
const metricsDebug = import.meta.env.METRICS_DEBUG === "true";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <BaseHead
      site={site}
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      jsonLd={jsonLd}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <SiteHeader site={site} transparent={headerTransparent} />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter site={site} email={email} hideContact={hideFooterContact} />

    <script is:inline define:vars={{ metricsUrl, metricsKey, metricsDebug }}>
      window.__RYOKO_METRICS__ = {
        url: metricsUrl,
        key: metricsKey,
        debug: metricsDebug,
      };
    </script>
    <script>
      import "@/scripts/analytics";
      import "@/scripts/ui";
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    min-height: 50vh;
  }
</style>
