---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CrowMark from "@/components/ui/CrowMark.astro";
import EyeMark from "@/components/ui/EyeMark.astro";
import Icon from "@/components/ui/Icon.astro";
---

<BaseLayout
  title="404"
  description="Esta página se perdió entre los cuervos."
  noindex
  canonicalPath="/404"
>
  <section class="not-found grain" aria-labelledby="not-found-title">
    <div class="not-found__eye" aria-hidden="true">
      <EyeMark size={420} />
    </div>

    <div class="not-found__inner shell">
      <p class="not-found__code">Error 404</p>
      <h1 class="not-found__title" id="not-found-title">
        Esta página se perdió <span>entre los cuervos.</span>
      </h1>
      <p class="not-found__text">
        El enlace está roto, la página cambió de lugar o nunca existió. Puedes volver al inicio o
        seguir leyendo.
      </p>

      <div class="not-found__actions">
        <a class="btn btn--primary" href="/">
          Volver al inicio
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn--secondary" href="/blog">Leer el blog</a>
        <a class="btn btn--ghost" href="/proyectos">Ver proyectos</a>
      </div>

      <CrowMark size={54} class="not-found__crow" />
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .not-found__eye {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--color-red);
    opacity: 0.14;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-red-bright);
  }

  .not-found__title {
    max-width: 15ch;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .not-found__title span {
    color: var(--color-muted);
  }

  .not-found__text {
    max-width: 46ch;
    margin-top: 1.25rem;
    color: var(--color-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .not-found__crow {
    margin-top: 3rem;
    color: var(--color-line-strong);
  }
</style>
