---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedPost from "@/components/blog/FeaturedPost.astro";
import Pagination from "@/components/blog/Pagination.astro";
import PostRow from "@/components/blog/PostRow.astro";
import TagFilter from "@/components/blog/TagFilter.astro";
import { getPosts, getSiteSettings, getTags } from "@/lib/cms/queries";
import { blogJsonLd } from "@/lib/jsonld";

const [posts, tags, site] = await Promise.all([
  getPosts({ page: 1, limit: 10 }),
  getTags(),
  getSiteSettings(),
]);

const featured = posts.data.find((post) => post.featured) ?? posts.data[0] ?? null;
const rest = featured ? posts.data.filter((post) => post.id !== featured.id) : posts.data;
const description =
  "Notas técnicas, decisiones de arquitectura y cosas que aprendo mientras construyo.";

const jsonLd = blogJsonLd("Karasu / Bitácora", description, new URL("/blog", site.url).toString());
---

<BaseLayout
  title="Karasu / Bitácora"
  description={description}
  canonicalPath="/blog"
  ogImage="/og/blog.png"
  jsonLd={[jsonLd]}
>
  <div class="shell">
    <header class="page-head">
      <p class="page-kicker">Karasu / Bitácora</p>
      <div class="page-head__row">
        <div>
          <h1 class="page-title">Bitácora</h1>
          <p class="page-lede">{description}</p>
        </div>
      </div>
    </header>

    <TagFilter tags={tags} />

    {
      posts.data.length === 0 ? (
        <div class="blog-empty">
          <p class="blog-empty__title">Todavía no hay posts publicados.</p>
          <p class="muted">Estoy escribiendo el primero. Mientras tanto, puedes ver los proyectos.</p>
          <a class="link-arrow" href="/proyectos">
            Ver proyectos
          </a>
        </div>
      ) : (
        <>
          {featured && <FeaturedPost post={featured} index={1} />}
          <div class="blog-list">
            {rest.map((post) => (
              <PostRow post={post} />
            ))}
          </div>
          <Pagination page={posts.meta.page} totalPages={posts.meta.total_pages} />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-list {
    border-top: 1px solid var(--color-line);
  }

  .blog-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .blog-empty__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
  }
</style>
