---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import SmartImage from "@/components/ui/SmartImage.astro";
import CrowMark from "@/components/ui/CrowMark.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { getLanding, getSiteSettings } from "@/lib/cms/queries";
import { formatDate } from "@/lib/dates";
import { techIcons } from "@/lib/images";
import { personJsonLd } from "@/lib/jsonld";
import { mediaSource } from "@/lib/media";

const [landing, site] = await Promise.all([getLanding(), getSiteSettings()]);
const { about, stack, certifications, contact } = landing;
const photo = mediaSource(about.photo);
const paragraphs = about.body_md.split("\n\n").filter(Boolean);
const jsonLd = personJsonLd(site);
---

<BaseLayout
  title="Sobre mí"
  description="Ricardo Reyes Gómez (Ryoko): estudiante de ITID en UPChiapas, desarrollo full stack con enfoque en seguridad y arquitectura Zero Trust."
  canonicalPath="/sobre-mi"
  ogImage="/og/sobre-mi.png"
  jsonLd={[jsonLd]}
  hideFooterContact
>
  <div class="shell">
    <header class="page-head">
      <p class="page-kicker">Ricardo Reyes Gómez / Ryoko</p>
      <div class="page-head__row">
        <div>
          <h1 class="page-title">Sobre mí</h1>
          <p class="page-lede">
            Estudiante, desarrollador y una persona que prefiere entender cómo funciona algo antes
            de usarlo.
          </p>
        </div>
        <p class="about-location">Chiapas, México / 2026</p>
      </div>
    </header>

    <section class="about-intro" aria-label="Biografía">
      <div class="about-intro__media reveal">
        {photo && about.photo ? (
          <SmartImage
            src={photo}
            alt={about.photo.alt}
            width={720}
            height={900}
            widths={[360, 540, 720]}
            sizes="(max-width: 800px) 80vw, 32vw"
            format="avif"
            quality={82}
            loading="eager"
          />
        ) : (
          <div class="about-intro__placeholder">
            <CrowMark size={90} />
          </div>
        )}
        <span class="about-intro__caption">Ricardo Reyes Gómez / Chiapas, MX</span>
      </div>

      <div class="about-intro__body reveal">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <dl class="about-facts">
          {about.facts.map((fact) => (
            <div class="about-facts__item">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="about-intro__links">
          <a class="link-arrow" href={site.author.github_url ?? "https://github.com/RyuheiRG"}>
            <Icon name="github" size={15} />
            GitHub
          </a>
          <a
            class="link-arrow"
            href={site.author.linkedin_url ?? "https://www.linkedin.com/in/ryuhei-rg/"}
          >
            <Icon name="linkedin" size={15} />
            LinkedIn
          </a>
          <a class="link-arrow" href={`mailto:${contact.email}`}>
            <Icon name="mail" size={15} />
            Email
          </a>
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="stack-title">
      <div class="about-section__head">
        <SectionLabel number="01" label="Stack" />
        <h2 class="about-section__title" id="stack-title">
          Herramientas que uso.
        </h2>
      </div>

      <div class="stack-grid">
        {stack.map((group) => (
          <div class="stack-group">
            <h3 class="stack-group__title">{group.category}</h3>
            <ul class="stack-group__list">
              {group.items.map((item) => {
                const icon = item.icon ? techIcons[item.icon] : undefined;
                return (
                  <li class="stack-item">
                    {icon ? (
                      <Image
                        src={icon}
                        alt=""
                        width={20}
                        height={20}
                        loading="lazy"
                        class="stack-item__icon"
                      />
                    ) : (
                      <span class="stack-item__dot" aria-hidden="true" />
                    )}
                    <span>{item.name}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="timeline-title">
      <div class="about-section__head">
        <SectionLabel number="02" label="Trayectoria" />
        <h2 class="about-section__title" id="timeline-title">
          Hasta ahora.
        </h2>
      </div>

      <ol class="timeline">
        {about.timeline.map((entry, index) => (
          <li class="timeline__item">
            <span class="timeline__year">{entry.year}</span>
            <span class="timeline__marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="timeline__body">
              <h3 class="timeline__title">{entry.title}</h3>
              {entry.description && <p class="timeline__text">{entry.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-section" aria-labelledby="certs-title">
      <div class="about-section__head">
        <SectionLabel number="03" label="Certificaciones" />
        <h2 class="about-section__title" id="certs-title">
          Constancia.
        </h2>
      </div>

      <ul class="certs">
        {certifications.map((certification, index) => (
          <li class="certs__item">
            <span class="certs__index">{String(index + 1).padStart(2, "0")}</span>
            <div class="certs__body">
              <h3 class="certs__title">{certification.title}</h3>
              <p class="certs__issuer">{certification.issuer}</p>
            </div>
            <time class="certs__date" datetime={certification.date}>
              {formatDate(certification.date)}
            </time>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact-block" aria-labelledby="contact-title">
      <p class="eyebrow eyebrow--red">04 / Contacto</p>
      <h2 class="contact-block__title" id="contact-title">
        {contact.title}
      </h2>
      <p class="contact-block__body">{contact.body}</p>
      <a class="contact-block__email" href={`mailto:${contact.email}`}>
        {contact.email}
        <Icon name="arrow-up-right" size={28} />
      </a>
      <div class="contact-block__links">
        {contact.links.map((link) => (
          <a class="link-arrow" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
            <Icon name="arrow-up-right" size={14} />
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-location {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-line);
  }

  .about-intro__media {
    position: relative;
    max-width: 360px;
  }

  .about-intro__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2) brightness(0.9);
    border: 1px solid var(--color-line);
  }

  .about-intro__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .about-intro__caption {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faint);
    text-align: right;
  }

  .about-intro__body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding-top: 0.5rem;
  }

  .about-intro__body > p {
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .about-intro__body > p:first-child {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.15rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-bone);
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 1rem 0 0;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .about-facts__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 0.95rem;
    background: var(--color-ink);
  }

  .about-facts__item dt {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .about-facts__item dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-bone);
  }

  .about-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .about-section {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-line);
  }

  .about-section__head {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .about-section__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .stack-group {
    padding: 1.15rem;
    background: var(--color-ink);
  }

  .stack-group__title {
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red-bright);
  }

  .stack-group__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .stack-item__icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.35);
    opacity: 0.7;
    transition:
      filter 150ms ease-out,
      opacity 150ms ease-out;
  }

  .stack-item:hover .stack-item__icon {
    filter: grayscale(1) brightness(1.6);
    opacity: 1;
  }

  .stack-item__dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-line-strong);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 5rem 4rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--color-line);
  }

  .timeline__year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-bone);
  }

  .timeline__marker {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--color-red-bright);
  }

  .timeline__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .timeline__text {
    max-width: 56ch;
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .certs__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--color-line);
  }

  .certs__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--color-red-bright);
  }

  .certs__title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .certs__issuer {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .certs__date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }

  .contact-block {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .contact-block__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .contact-block__body {
    max-width: 46ch;
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .contact-block__email {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-bone);
    transition: color 180ms ease-out;
  }

  .contact-block__email svg {
    margin-top: 0.15em;
    color: var(--color-red);
  }

  .contact-block__email:hover {
    color: var(--color-red-bright);
  }

  .contact-block__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .about-intro {
      grid-template-columns: 1fr;
    }

    .about-intro__media {
      max-width: 280px;
    }

    .about-section__head {
      grid-template-columns: 1fr;
    }

    .stack-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .about-facts {
      grid-template-columns: 1fr;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }

    .timeline__item {
      grid-template-columns: 3.5rem 2.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .certs__item {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .certs__date {
      grid-column: 2;
    }
  }
</style>
