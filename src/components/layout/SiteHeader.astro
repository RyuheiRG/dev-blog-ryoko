---
import CrowMark from "@/components/ui/CrowMark.astro";
import Icon from "@/components/ui/Icon.astro";
import type { SiteSettings } from "@/data/schemas";

interface Props {
  site: SiteSettings;
  transparent?: boolean;
}

const { site, transparent = false } = Astro.props;
const path = Astro.url.pathname;

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class:list={["site-header", transparent && "site-header--transparent"]}
  data-site-header
  data-transparent={transparent ? "true" : "false"}
>
  <div class="site-header__inner shell">
    <a href="/" class="brand" aria-label="Ryoko — inicio">
      <CrowMark size={30} class="brand__mark" />
      <span class="brand__name">Ryoko</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", isActive(item.href) && "is-active"]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        href="https://github.com/RyuheiRG"
        class="header-icon"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de RyuheiRG"
      >
        <Icon name="github" size={18} />
      </a>
      <button
        type="button"
        class="menu-button"
        data-menu-open
        aria-label="Abrir menú"
        aria-haspopup="dialog"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<dialog class="mobile-menu" data-mobile-menu aria-label="Menú de navegación">
  <div class="mobile-menu__top">
    <span class="brand brand--static">
      <CrowMark size={28} class="brand__mark" />
      <span class="brand__name">Ryoko</span>
    </span>
    <button type="button" class="menu-button" data-menu-close aria-label="Cerrar menú">
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="mobile-menu__nav" aria-label="Navegación móvil">
    {site.nav.map((item, index) => (
      <a href={item.href} class="mobile-menu__link">
        <span class="mobile-menu__index">0{index + 1}</span>
        <span>{item.label}</span>
        <Icon name="arrow-up-right" size={22} />
      </a>
    ))}
  </nav>

  <div class="mobile-menu__footer">
    <a href="/rss.xml" class="mobile-menu__small">RSS</a>
    <a
      href="https://github.com/RyuheiRG"
      class="mobile-menu__small"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
    <a
      href="https://www.linkedin.com/in/ryuhei-rg/"
      class="mobile-menu__small"
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn
    </a>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: color-mix(in srgb, var(--color-ink) 86%, transparent);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(14px);
    transition:
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }

  .site-header--transparent {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  .site-header--transparent.is-solid {
    background: color-mix(in srgb, var(--color-ink) 86%, transparent);
    border-bottom-color: var(--color-line);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-bone);
  }

  .brand__mark {
    color: var(--color-bone);
    transition: color 150ms ease-out;
  }

  .brand:hover .brand__mark {
    color: var(--color-red-bright);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .nav-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-block: 0.4rem;
    transition: color 150ms ease-out;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-red);
    transition: right 200ms var(--ease-soft);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-bone);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    right: 0;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--color-muted);
    transition: color 150ms ease-out;
  }

  .header-icon:hover {
    color: var(--color-red-bright);
  }

  .menu-button {
    display: none;
    width: 40px;
    height: 40px;
    place-items: center;
    color: var(--color-bone);
    border: 1px solid var(--color-line);
    border-radius: 2px;
  }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1.25rem var(--gutter) 2rem;
    background: var(--color-ink);
    color: var(--color-bone);
    border: 0;
  }

  .mobile-menu::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    padding-block: 2.5rem;
  }

  .mobile-menu__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .mobile-menu__link svg {
    color: var(--color-red);
    align-self: center;
  }

  .mobile-menu__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--color-red-bright);
  }

  .mobile-menu__footer {
    display: flex;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .mobile-menu__small {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .desktop-nav,
    .header-icon {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .site-header--transparent {
      background: color-mix(in srgb, var(--color-ink) 86%, transparent);
      border-bottom-color: var(--color-line);
      backdrop-filter: blur(14px);
    }
  }
</style>
