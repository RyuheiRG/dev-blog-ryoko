---
interface Props {
  name:
    | "arrow-up-right"
    | "arrow-right"
    | "arrow-left"
    | "chevron-left"
    | "chevron-right"
    | "menu"
    | "close"
    | "copy"
    | "check"
    | "mail"
    | "rss"
    | "github"
    | "linkedin"
    | "external";
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.6, class: className } = Astro.props;

const strokePaths: Record<string, string[]> = {
  "arrow-up-right": ["M7 17 17 7", "M8 7h9v9"],
  "arrow-right": ["M4 12h15", "m13 6 6 6-6 6"],
  "arrow-left": ["M20 12H5", "m11 6-6 6 6 6"],
  "chevron-left": ["m14 6-6 6 6 6"],
  "chevron-right": ["m10 6 6 6-6 6"],
  menu: ["M4 7h16", "M4 12h16", "M4 17h16"],
  close: ["m6 6 12 12", "m18 6-12 12"],
  copy: ["M9 9h10v10H9z", "M5 15V5h10"],
  check: ["m5 12 4 4L19 6"],
  mail: ["M3 6h18v12H3z", "m3 7 9 6 9-6"],
  rss: ["M5 19a1 1 0 1 0 0-2 1 1 0 0 0 0 2", "M5 12a7 7 0 0 1 7 7", "M5 5a14 14 0 0 1 14 14"],
  external: ["M14 4h6v6", "M20 4 10 14", "M20 14v6H4V4h6"],
};

const brandPaths: Record<string, string> = {
  github:
    "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z",
  linkedin:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.19 0 22.22 0z",
};
---

{
  brandPaths[name] ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      class={className}
    >
      <path d={brandPaths[name]} />
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class={className}
    >
      {(strokePaths[name] ?? []).map((d) => <path d={d} />)}
    </svg>
  )
}
