---
interface Props {
  size?: number;
  class?: string;
  title?: string;
}

const { size = 28, class: className, title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 40"
  width={size}
  height={(size * 40) / 64}
  class={className}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path
    fill="currentColor"
    d="M7 33c6-1 10-4 13-9 2-4 5-7 9-8 4-1 7 0 10 2l5-4-2 6 7 1-6 3 4 5-7-1-2 6-5-4-5 6-1-6-8 5 3-6-7 3 2-5-7 1 3-4H7z"
  />
  <circle cx="44.5" cy="16.2" r="1.5" fill="var(--color-red)" />
</svg>
