---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  format?: "avif" | "webp" | "png" | "jpg";
  quality?: number;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  format,
  quality,
  loading = "lazy",
  fetchpriority,
  class: className,
} = Astro.props;

const isRemote = typeof src === "string";
---

{
  isRemote ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      widths={widths}
      sizes={sizes}
      format={format}
      quality={quality}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
    />
  )
}
