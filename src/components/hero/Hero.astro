---
import SmartImage from "@/components/ui/SmartImage.astro";
import CrowMark from "@/components/ui/CrowMark.astro";
import EyeMark from "@/components/ui/EyeMark.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Landing } from "@/data/schemas";
import { mediaSource } from "@/lib/media";

interface Props {
  hero: Landing["hero"];
}

const { hero } = Astro.props;
const portraitSrc = mediaSource(hero.portrait);
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky grain">
    <div class="hero__stage hero__stage--red" data-hero-stage="1">
      <div class="hero__grid grid-lines" aria-hidden="true"></div>

      <div class="hero__inner shell">
        <div class="hero__copy">
          <p class="hero__eyebrow">{hero.eyebrow}</p>
          <h1 class="hero__title" id="hero-title" data-hero-title>
            <span>Ryoko</span><span class="hero__title-dot" aria-hidden="true">.</span>
            <span class="sr-only"> — Ricardo Reyes Gómez</span>
          </h1>
          <p class="hero__sub">{hero.statement}</p>

          <div class="hero__actions">
            <a class="hero__cta hero__cta--solid" href={hero.primary_cta.href}>
              {hero.primary_cta.label}
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="hero__cta hero__cta--ghost" href={hero.secondary_cta.href}>
              {hero.secondary_cta.label}
            </a>
          </div>
        </div>

        {
          portraitSrc && hero.portrait && (
            <figure class="hero__portrait-wrap" data-hero-portrait>
              <div class="hero__portrait">
                <SmartImage
                  src={portraitSrc}
                  alt={hero.portrait.alt}
                  width={720}
                  height={960}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 800px) 60vw, 34vw"
                  format="avif"
                  quality={80}
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="hero__halftone" aria-hidden="true"></span>
                <span class="hero__portrait-line" aria-hidden="true"></span>
              </div>
              <figcaption>
                <span>Ricardo Reyes Gómez</span>
                <span>Chiapas, MX</span>
              </figcaption>
            </figure>
          )
        }
      </div>

      <div class="hero__meta" aria-hidden="true">
        <span>Full stack</span>
        <span class="hero__meta-sep"></span>
        <span>Zero Trust</span>
        <span class="hero__meta-sep"></span>
        <span>2026</span>
      </div>

      <a class="hero__skip" href="#statement">Saltar introducción</a>

      <div class="hero__scroll" aria-hidden="true">
        <span>Scroll</span>
        <span class="hero__scroll-line"></span>
      </div>
    </div>

    <div class="hero__stage hero__stage--ink" data-hero-stage="2" aria-hidden="true">
      <div class="hero__eye" data-hero-mark>
        <EyeMark size={620} />
      </div>
      <div class="hero__stage-inner shell">
        <p class="hero__stage-label">02 / Principio</p>
        <p class="hero__statement">Construyo sistemas que no confían en nada.</p>
        <p class="hero__micro">Verifico cada capa. Documento cada decisión.</p>
      </div>
      <span class="hero__stage-number" aria-hidden="true">02</span>
    </div>

    <div class="hero__stage hero__stage--crows" data-hero-stage="3" aria-hidden="true">
      <div class="hero__crows" aria-hidden="true">
        <div class="hero__crow hero__crow--one" data-crow><CrowMark size={420} /></div>
        <div class="hero__crow hero__crow--two" data-crow><CrowMark size={300} /></div>
        <div class="hero__crow hero__crow--three" data-crow><CrowMark size={520} /></div>
      </div>
      <div class="hero__glow" aria-hidden="true"></div>

      <div class="hero__stage-inner shell">
        <p class="hero__stage-label">03 / Trabajo seleccionado</p>
        <p class="hero__statement hero__statement--big">Sistemas con intención.</p>
        <a class="hero__cta hero__cta--line" href="#trabajo">
          Ver proyectos
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <span class="hero__stage-number" aria-hidden="true">03</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    background: var(--color-ink);
  }

  :global(html.js) .hero {
    height: 320vh;
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    will-change: opacity;
  }

  .hero__stage--red {
    z-index: 3;
    background: var(--color-crimson);
    color: var(--color-bone);
  }

  .hero__stage--ink {
    z-index: 2;
    background: var(--color-ink);
    opacity: 0;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .hero__stage--crows {
    z-index: 1;
    background: var(--color-ink);
    opacity: 0;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    width: 100%;
    padding-top: var(--header-h);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-bone) 72%, transparent);
  }

  .hero__title {
    margin-top: 0.2em;
    font-family: var(--font-display);
    font-size: clamp(6rem, 21vw, 18rem);
    font-weight: 400;
    line-height: 0.74;
    letter-spacing: -0.055em;
    color: var(--color-bone);
    transform-origin: left center;
  }

  .hero__title-dot {
    color: var(--color-ink);
  }

  .hero__sub {
    margin-top: clamp(2rem, 5.5vh, 3.5rem);
    max-width: 32ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-bone) 82%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vh, 2.25rem);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0.8rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out;
  }

  .hero__cta--solid {
    background: var(--color-bone);
    border-color: var(--color-bone);
    color: var(--color-ink);
  }

  .hero__cta--solid:hover {
    background: #ffffff;
    border-color: #ffffff;
  }

  .hero__cta--ghost {
    border-color: color-mix(in srgb, var(--color-bone) 38%, transparent);
    color: var(--color-bone);
  }

  .hero__cta--ghost:hover {
    border-color: var(--color-bone);
  }

  .hero__cta--line {
    margin-top: 1.75rem;
    padding-left: 0;
    border: 0;
    color: var(--color-red-bright);
  }

  .hero__cta--line:hover {
    color: var(--color-red);
  }

  .hero__portrait-wrap {
    position: relative;
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 340px;
    transform: translate3d(8%, 0, 0);
    will-change: transform;
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-red-deep);
    border: 1px solid color-mix(in srgb, var(--color-bone) 22%, transparent);
  }

  .hero__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25) brightness(0.92);
    mix-blend-mode: multiply;
    transform: scale(1.02);
  }

  .hero__halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(9, 10, 12, 0.55) 1px, transparent 1.2px);
    background-size: 4px 4px;
    opacity: 0.35;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .hero__portrait-line {
    position: absolute;
    left: 1rem;
    top: 1rem;
    bottom: 1rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-bone) 45%, transparent);
  }

  .hero__portrait-wrap figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-bone) 65%, transparent);
  }

  .hero__meta {
    position: absolute;
    left: var(--gutter);
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-bone) 60%, transparent);
  }

  .hero__meta-sep {
    width: 18px;
    height: 1px;
    background: color-mix(in srgb, var(--color-bone) 30%, transparent);
  }

  .hero__skip {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-bone) 60%, transparent);
    transition: color 150ms ease-out;
  }

  .hero__skip:hover {
    color: var(--color-bone);
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 1rem);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-bone) 55%, transparent);
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 54px;
    background: color-mix(in srgb, var(--color-bone) 35%, transparent);
  }

  .hero__stage-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero__stage-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-red-bright);
  }

  .hero__statement {
    max-width: 17ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 8vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--color-bone);
  }

  .hero__statement--big {
    max-width: 14ch;
  }

  .hero__micro {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__eye {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--color-red);
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(0.9);
    filter: drop-shadow(0 0 60px rgba(240, 68, 82, 0.22));
    transform-origin: center;
  }

  .hero__stage-number {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--color-faint);
  }

  .hero__crows {
    position: absolute;
    inset: 0;
    color: #191b1f;
  }

  .hero__crow {
    position: absolute;
    will-change: transform;
  }

  .hero__crow--one {
    top: 12%;
    left: -6%;
    transform: rotate(-8deg);
  }

  .hero__crow--two {
    top: 46%;
    left: 36%;
    transform: rotate(6deg);
    opacity: 0.8;
  }

  .hero__crow--three {
    top: 30%;
    right: -8%;
    transform: rotate(-4deg);
    opacity: 0.65;
  }

  .hero__glow {
    position: absolute;
    width: 40vw;
    aspect-ratio: 1;
    top: 18%;
    right: 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(193, 18, 31, 0.18), transparent 65%);
    pointer-events: none;
  }

  @media (max-width: 800px) {
    :global(html.js) .hero {
      height: 230vh;
    }

    .hero__inner {
      position: static;
      grid-template-columns: 1fr;
      align-content: end;
      padding-bottom: 4rem;
    }

    .hero__copy {
      position: relative;
      z-index: 2;
    }

    .hero__portrait-wrap {
      position: absolute;
      inset: calc(var(--header-h) + 1rem) calc(var(--gutter) * -1) auto auto;
      width: 58%;
      max-width: none;
      opacity: 0.55;
      z-index: 1;
    }

    .hero__portrait {
      aspect-ratio: 3 / 4;
    }

    .hero__portrait-wrap figcaption {
      display: none;
    }

    .hero__title {
      font-size: clamp(5.5rem, 27vw, 9rem);
    }

    .hero__meta,
    .hero__scroll {
      display: none;
    }

    .hero__stage--ink,
    .hero__stage--crows {
      padding-bottom: 4rem;
    }

    .hero__statement {
      max-width: 15ch;
      font-size: clamp(2.4rem, 10vw, 3.6rem);
    }

    .hero__eye {
      top: 38%;
      opacity: 0.55;
    }

    .hero__eye :global(svg) {
      width: 300px;
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    :global(html.js) .hero {
      height: 100svh;
    }

    .hero__stage--ink,
    .hero__stage--crows {
      display: none;
    }

    .hero__portrait-wrap {
      transform: none;
    }
  }
</style>
