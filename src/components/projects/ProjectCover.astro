---
import SmartImage from "@/components/ui/SmartImage.astro";
import TypographicCover from "@/components/ui/TypographicCover.astro";
import type { ProjectSummary } from "@/data/schemas";
import { mediaSource } from "@/lib/media";

interface Props {
  project: ProjectSummary;
  index: number;
  priority?: boolean;
  class?: string;
}

const { project, index, priority = false, class: className } = Astro.props;
const src = mediaSource(project.cover);
const isPortrait = project.cover ? project.cover.height / project.cover.width > 1.15 : false;
const paddedIndex = String(index).padStart(2, "0");
---

{src && project.cover ? (
  <figure class:list={["project-cover", className]}>
    <div class:list={["project-cover__frame", isPortrait && "project-cover__frame--phone"]}>
      <SmartImage
        src={src}
        alt={project.cover.alt}
        width={isPortrait ? 540 : 1200}
        height={isPortrait ? 1200 : 750}
        widths={isPortrait ? [360, 540, 720] : [640, 960, 1200]}
        sizes={isPortrait ? "(max-width: 768px) 60vw, 360px" : "(max-width: 768px) 100vw, 640px"}
        format="avif"
        quality={82}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
      {isPortrait && (
        <figcaption class="project-cover__caption">
          <span>Android</span>
          <span>{project.title}</span>
        </figcaption>
      )}
    </div>
  </figure>
) : (
  <div class:list={["project-cover", className]}>
    <TypographicCover
      title={project.title}
      label={`Proyecto / ${project.year}`}
      index={paddedIndex}
      note="Sin imagen todavía"
    />
  </div>
)}

<style>
  .project-cover {
    margin: 0;
    width: 100%;
  }

  .project-cover__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #0c0e11;
    border: 1px solid var(--color-line);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .project-cover__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-cover__frame--phone {
    background:
      radial-gradient(circle at 50% 60%, rgba(193, 18, 31, 0.16), transparent 55%), #0c0e11;
  }

  .project-cover__frame--phone :global(img) {
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 3vw, 2rem);
    object-fit: contain;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .project-cover--row .project-cover__frame--phone {
    aspect-ratio: 1 / 1;
  }

  .project-cover__caption {
    position: absolute;
    inset: auto 1rem 0.9rem auto;
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .project-cover__caption span:first-child {
    color: var(--color-red-bright);
  }

  :global(a:hover) .project-cover__frame :global(img) {
    transform: scale(1.012);
  }

  .project-cover__frame :global(img) {
    transition: transform 600ms var(--ease-out-expo);
  }

  @media (max-width: 640px) {
    .project-cover__caption {
      display: none;
    }
  }
</style>
