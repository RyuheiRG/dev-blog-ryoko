---
import SmartImage from "@/components/ui/SmartImage.astro";
import CrowMark from "@/components/ui/CrowMark.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { Landing } from "@/data/schemas";
import { mediaSource } from "@/lib/media";

interface Props {
  about: Landing["about"];
}

const { about } = Astro.props;
const photo = mediaSource(about.photo);
const paragraphs = about.body_md.split("\n\n").filter(Boolean);
---

<section class="section about-strip">
  <div class="shell about-strip__grid">
    <div class="about-strip__media reveal">
      {
        photo && about.photo ? (
          <SmartImage
            src={photo}
            alt={about.photo.alt}
            width={640}
            height={800}
            widths={[320, 480, 640]}
            sizes="(max-width: 800px) 70vw, 30vw"
            format="avif"
            quality={80}
            loading="lazy"
          />
        ) : (
          <div class="about-strip__placeholder" aria-hidden="true">
            <CrowMark size={80} />
          </div>
        )
      }
      <span class="about-strip__frame" aria-hidden="true"></span>
    </div>

    <div class="about-strip__body reveal">
      <SectionLabel number="04" label="Sobre mí" />
      <h2 class="about-strip__title">
        Estudiante de ITID.<br />
        <span>Constructor de sistemas.</span>
      </h2>
      <p class="about-strip__text">
        Estudiante de ITID en UPChiapas. Me interesan la arquitectura de aplicaciones, la
        seguridad y los sistemas que se pueden entender.
      </p>
      <p class="about-strip__text about-strip__text--muted">
        {paragraphs[1] ??
          "Escribo lo que aprendo y documento las decisiones para que otro pueda continuar el trabajo."}
      </p>

      <a class="link-arrow about-strip__cta" href="/sobre-mi">
        Sobre mí
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</section>

<style>
  .about-strip__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .about-strip__media {
    position: relative;
    max-width: 340px;
  }

  .about-strip__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2) brightness(0.9);
    border: 1px solid var(--color-line);
  }

  .about-strip__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .about-strip__frame {
    position: absolute;
    inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-red) 45%, transparent);
    z-index: -1;
    pointer-events: none;
  }

  .about-strip__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .about-strip__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .about-strip__title span {
    color: var(--color-muted);
  }

  .about-strip__text {
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-bone);
  }

  .about-strip__text--muted {
    color: var(--color-muted);
  }

  .about-strip__cta {
    margin-top: 0.6rem;
  }

  @media (max-width: 800px) {
    .about-strip__grid {
      grid-template-columns: 1fr;
    }

    .about-strip__media {
      max-width: 260px;
    }

    .about-strip__frame {
      inset: 0.5rem -0.5rem -0.5rem 0.5rem;
    }
  }
</style>
