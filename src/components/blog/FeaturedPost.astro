---
import SmartImage from "@/components/ui/SmartImage.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import TypographicCover from "@/components/ui/TypographicCover.astro";
import Icon from "@/components/ui/Icon.astro";
import type { PostSummary } from "@/data/schemas";
import { mediaSource } from "@/lib/media";

interface Props {
  post: PostSummary;
  index?: number;
}

const { post, index = 1 } = Astro.props;
const src = mediaSource(post.cover);
const padded = String(index).padStart(2, "0");
---

<article class="featured reveal">
  <a class="featured__media" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
    {
      src && post.cover ? (
        <SmartImage
          src={src}
          alt={post.cover.alt}
          width={1200}
          height={750}
          widths={[640, 960, 1200]}
          sizes="(max-width: 900px) 100vw, 58vw"
          format="avif"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <TypographicCover
          title={post.title}
          label="Karasu / Bitácora"
          index={padded}
          note="Destacado"
        />
      )
    }
  </a>

  <div class="featured__body">
    <p class="eyebrow eyebrow--red">Destacado / {padded}</p>
    <h2 class="featured__title">
      <a href={`/blog/${post.slug}`}>{post.title}</a>
    </h2>
    <p class="featured__excerpt">{post.excerpt}</p>
    <PostMeta post={post} showTags />

    <a class="link-arrow featured__cta" href={`/blog/${post.slug}`}>
      Leer el post
      <Icon name="arrow-up-right" size={15} />
    </a>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-line);
  }

  .featured__media {
    display: block;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .featured__media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 600ms var(--ease-out-expo);
  }

  .featured__media:hover :global(img) {
    transform: scale(1.015);
  }

  .featured__media :global(.type-cover) {
    transition: transform 600ms var(--ease-out-expo);
  }

  .featured__media:hover :global(.type-cover) {
    transform: scale(1.01);
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .featured__title {
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4.4vw, 3.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .featured__title a {
    transition: color 180ms ease-out;
  }

  .featured__title a:hover {
    color: var(--color-red-bright);
  }

  .featured__excerpt {
    max-width: 44ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .featured__cta {
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
