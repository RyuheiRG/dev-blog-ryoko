---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  page: number;
  totalPages: number;
  basePath?: string;
}

const { page, totalPages, basePath = "/blog" } = Astro.props;
const hrefFor = (value: number) => (value <= 1 ? basePath : `${basePath}/page/${value}`);
const hasPrev = page > 1;
const hasNext = page < totalPages;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Paginación">
      <div class="pagination__side">
        {hasPrev && (
          <a class="pagination__link" href={hrefFor(page - 1)} rel="prev">
            <Icon name="arrow-left" size={16} />
            Anterior
          </a>
        )}
      </div>

      <p class="pagination__info">
        Página {String(page).padStart(2, "0")} / {String(totalPages).padStart(2, "0")}
      </p>

      <div class="pagination__side pagination__side--end">
        {hasNext && (
          <a class="pagination__link" href={hrefFor(page + 1)} rel="next">
            Siguiente
            <Icon name="arrow-right" size={16} />
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .pagination__side {
    display: flex;
  }

  .pagination__side--end {
    justify-content: flex-end;
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 150ms ease-out;
  }

  .pagination__link:hover {
    color: var(--color-red-bright);
  }

  .pagination__info {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  @media (max-width: 560px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }

    .pagination__info {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }
  }
</style>
